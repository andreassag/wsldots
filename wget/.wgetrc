# server-provided last modification date
timestamping = on

# Do not go up in the directory structure
no_parent = on

# Wait 60 seconds before timing out
timeout = 60

# Retry a few times when a download fails
tries = 3

# Retry even when the connection was refused
retry_connrefused = on

# Do not let server redirects dictate local file names
trust_server_names = off

# Do not follow unencrypted FTP links from HTML documents
follow_ftp = off

# Ignore robots.txt
robots = off

# Force default encoding
local_encoding = UTF-8

# Force HTTPS in recursive mode
httpsonly = on

# HTTPS security
secureprotocol = auto
